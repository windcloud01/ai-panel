{
  "name": "muse-console-fork",
  "productName": "Muse Console",
  "version": "1.3.3",
  "license": "MIT",
  "description": "Muse 多账号面板 + 团队桥调度台（Muse Panel 的 fork：拆除上游更新器、桥调度台证书钉扎、NAS 智能体页）",
  "main": "./out/main/index.js",
  "author": "windcloud01",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "site.muse-console.app",
    "productName": "Muse Console",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "MuseConsole_${version}_arm64.${ext}"
    }
  }
}
